# Apache 2.4+: public URLs without .html; local files remain ordinary HTML.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Only redirect requests made by the browser, never internal rewrites.
    RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ ./ [R=301,L]

    RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html(?:[?\s]) [NC]
    RewriteRule ^(.+)\.html$ $1/ [R=301,L]

    # Serve /page/ from page.html when that file exists.
    # Relative substitution also supports installation in a subdirectory.
    RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
    RewriteCond %1.html -f
    RewriteRule ^(.+?)/?$ $1.html [END]
</IfModule>
